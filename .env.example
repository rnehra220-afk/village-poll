# Supabase (create a free project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel password (choose a strong one; never commit the real value)
ADMIN_PASSWORD=change-this-admin-password

# Public site URL (no trailing slash) — used for canonical URLs, sitemap, share links
SITE_URL=https://your-domain.com

# Optional: secret salt for anonymous voter hashes (defaults to ADMIN_PASSWORD; set a dedicated one in production)
# VOTE_SALT=another-long-random-secret

# Optional: contact email shown on the Contact page
# NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Optional: Google Search Console verification code (meta tag content only)
# GSC_VERIFICATION=your-gsc-code

# Optional: turn ad placeholders on/off site-wide
# ADS_ENABLED=true
